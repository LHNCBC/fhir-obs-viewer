{
  "name": "fhir-obs-viewer",
  "version": "7.9.6",
  "scripts": {
    "ng": "ng",
    "sync-generated-assets": "node bin/sync-generated-assets.js",
    "sync-xlsx-config": "node bin/sync-xlsx-config.js",
    "start": "npm run sync-xlsx-config && ng serve --poll=2000",
    "start:skip-xlsx": "SKIP_XLSX=1 npm run sync-xlsx-config && ng serve --poll=2000",
    "start-dist": "npm run sync-xlsx-config && ng serve --configuration production --poll=2000",
    "start-public": "npm run sync-xlsx-config && node bin/start-public.js",
    "start-public:skip-xlsx": "SKIP_XLSX=1 npm run sync-xlsx-config && node bin/start-public.js",
    "start-dist-public": "npm run sync-xlsx-config && node bin/start-public.js --dist",
    "analyze": "npm run sync-xlsx-config && ng build --configuration production --source-map && source-map-explorer public/main.*",
    "analyze-gzip": "npm run sync-xlsx-config && ng build --configuration production --source-map && source-map-explorer public/main.* --gzip",
    "build": "npm run sync-xlsx-config && ng build --configuration production && npm run build-autoconfig",
    "unit": "ng test --watch=false",
    "test": "npm run lint && npm run sync-xlsx-config && npm run test-autoconfig && npm run unit && npm run e2e",
    "lint": "ng lint",
    "e2e": "ng run fhir-obs-viewer:cypress-e2e",
    "cypress:open": "ng run fhir-obs-viewer:cypress-open",
    "prettier-fix": "prettier --write '**/*.ts'",
    "update-excel-config": "node bin/update-excel-configurations.js && npm run build",
    "update-cached-lists": "node bin/update-non-required-binding-lists.js",
    "build-autoconfig": "node autoconfig-src/build-autoconfig.js",
    "test-autoconfig": "node --test autoconfig-src/autoconfig.test.js",
    "autoconfig": "NODE_TLS_REJECT_UNAUTHORIZED=0 node autoconfig-build/autoconfig.js",
    "update-cached-initialization-settings": "node bin/update-cached-initialization-settings.js",
    "post-evidence-variable-data": "curl -X POST 'https://lforms-fhir.nlm.nih.gov/baseR4' -H 'Content-Type: application/fhir+json; charset=UTF-8' -d '@evidence-variable-r4-bundle.json'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "autocomplete-lhc": "^20.1.1",
    "commander": "^14.0.3",
    "csv-stringify": "^6.6.0",
    "fhirclient": "^2.5.5",
    "fhirpath": "^4.8.5",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "json5": "^2.2.3",
    "lodash-es": "^4.17.23",
    "ngx-toastr": "^15.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.17",
    "@cypress/schematic": "^4.3.0",
    "@cypress/webpack-preprocessor": "^5.17.1",
    "@types/fhir": "^0.0.41",
    "@types/hapi": "^18.0.15",
    "@types/jasmine": "~3.6.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "angular-eslint": "21.0.1",
    "cypress": "^13.17.0",
    "cypress-file-upload": "^5.0.8",
    "cypress-pipe": "^2.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "jquery": "^3.7.1",
    "jsdom": "^29.1.1",
    "json5-writer": "^0.2.0",
    "less": "^4.2.0",
    "mock-xmlhttprequest": "^8.4.1",
    "ng-mocks": "^14.15.3",
    "prettier": "2.2.1",
    "read-excel-file": "^5.8.8",
    "source-map-explorer": "^2.5.3",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^4.1.8",
    "write-excel-file": "^1.4.30",
    "xlsx": "^0.18.5",
    "xmlhttprequest": "^1.8.0"
  },
  "overrides": {
    "expo-random": "11.2.0"
  }
}
